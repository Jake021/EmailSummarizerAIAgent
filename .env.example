# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model (cheaper option for high volume: claude-haiku-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Outlook: Application (client) ID from your Azure app registration
MS_CLIENT_ID=

# Dashboard / startup (all optional)
# DIGEST_PROVIDERS=outlook        # comma list: outlook,gmail
# DIGEST_DAYS=1
# DIGEST_MAX=20
# DASHBOARD_PORT=4545
# STALE_HOURS=8                   # startup only re-summarizes if the last digest is older than this
